# ==============================================================================
# MFA Physical Token Simulator - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   copy .env.example .env (Windows PowerShell)
#   cp .env.example .env   (Linux/macOS)
#
# DO NOT commit your real '.env' file or AWS credentials to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application Settings
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-this-to-a-random-32-byte-hex-string-for-production

# ------------------------------------------------------------------------------
# OTP Security & Timing Policies
# ------------------------------------------------------------------------------
# Time-To-Live (TTL) for each generated OTP in seconds (default: 120 seconds)
OTP_TTL_SECONDS=120

# Educational Demo Display:
# 1 = Display OTP in response to simulate physical keyfob LCD in browser
# 0 = Do not return OTP in HTTP response (simulates production out-of-band delivery)
DEMO_SHOW_OTP=1

# Cooldown between OTP generation requests per IP address (seconds)
RATE_LIMIT_GENERATE_SECONDS=5

# Maximum failed verification attempts before the active OTP is invalidated
MAX_VERIFY_ATTEMPTS=5

# ------------------------------------------------------------------------------
# Logging & AWS CloudWatch Integration (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable or disable AWS CloudWatch Logs streaming
# 0 = Local console and file logging only (Default, no AWS needed)
# 1 = Stream application logs to AWS CloudWatch Logs
CLOUDWATCH_ENABLED=0

# AWS CloudWatch Log Group and Stream Configuration
CLOUDWATCH_LOG_GROUP=/aws/flask/MFA-Token-Simulator
CLOUDWATCH_LOG_STREAM=simulator-flask-stream

# AWS Region (default configured for user's AWS account: ap-southeast-2 Sydney)
AWS_DEFAULT_REGION=ap-southeast-2

# AWS Credentials (OPTIONAL - only needed if CLOUDWATCH_ENABLED=1)
# Recommended practice: Leave these blank and authenticate using standard AWS CLI:
#   aws configure
# Or set temporary credentials in your deployment platform's environment settings.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

